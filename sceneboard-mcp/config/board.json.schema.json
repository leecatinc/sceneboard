{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneboard.dev/schemas/board-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseUrl", "accessTokenRef", "authScheme", "timeoutMs", "profile"],
  "properties": {
    "version": { "const": 1 },
    "baseUrl": { "type": "string", "maxLength": 2048 },
    "accessTokenRef": {
      "type": "string",
      "pattern": "^(?:env://SCENEBOARD_ACCESS_TOKEN|store://[A-Za-z0-9][A-Za-z0-9_-]{0,63})$"
    },
    "authScheme": { "const": "bearer" },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }
  }
}
