{
  "name": "sceneboard-be",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "LeeCat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leecatinc/sceneboard.git"
  },
  "homepage": "https://sceneboard.dev",
  "bugs": {
    "url": "https://github.com/leecatinc/sceneboard/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "start": "node --import tsx dist/main.js",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-sql-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "db:migrate:status": "tsx src/bootstrap/persistence-certification.bootstrap.ts migration status",
    "db:migrate:up": "tsx src/bootstrap/persistence-certification.bootstrap.ts migration up",
    "db:migrate:adopt": "tsx src/bootstrap/persistence-certification.bootstrap.ts migration adopt",
    "db:prepare:lightweight": "tsx scripts/prepare-lightweight-database.ts",
    "security:calibrate:bcrypt": "tsx scripts/calibrate-bcrypt.ts",
    "security:calibrate:pairing": "tsx scripts/calibrate-pairing-claim.ts",
    "security:retention:status": "tsx scripts/run-security-retention.ts status",
    "security:retention:dry-run": "tsx scripts/run-security-retention.ts dry-run",
    "security:retention:run": "tsx scripts/run-security-retention.ts run"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.2.6",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@sceneboard/artifact-runtime": "0.0.0",
    "@sceneboard/board-schema": "0.0.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "css-tree": "^3.2.1",
    "ioredis": "5.11.1",
    "mysql2": "3.15.3",
    "nodemailer": "9.0.3",
    "parse5": "^8.0.1",
    "playwright": "1.59.1",
    "pptxgenjs": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "7.0.11",
    "typescript": "^5.6.0"
  }
}
