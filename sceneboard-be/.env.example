APP_ENV=development
NODE_ENV=development
PORT=3411
MYSQL_HOST=<sceneboard-host>
MYSQL_PORT=3306
MYSQL_USER=<sceneboard-user>
MYSQL_PASSWORD=<set-by-secret>
MYSQL_DATABASE=sceneboard
REDIS_HOST=<sceneboard-host>
REDIS_PORT=6379
REDIS_PASSWORD=<set-by-secret>
REDIS_DB=<sceneboard-db>
REDIS_KEY_PREFIX=sceneboard:
SCENEBOARD_GMAIL_USER=<set-by-secret>
SCENEBOARD_GMAIL_APP_PASSWORD=<set-by-secret>
FIREBASE_GOOGLE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=<set-by-secret>
FIREBASE_CLIENT_EMAIL=<set-by-secret>
FIREBASE_PRIVATE_KEY=<set-by-secret>
SESSION_TOKEN_KEY_B64=<set-by-secret>
GRANT_TOKEN_KEY_B64=<set-by-secret>
CSRF_KEY_B64=<set-by-secret>
PAIRING_CODE_PEPPER_B64=<set-by-secret>
AUDIT_HMAC_KEY_B64=<set-by-secret>
RATE_LIMIT_HMAC_KEY_B64=<set-by-secret>
BOARD_CURSOR_MAC_KEY_B64=<set-by-secret>
BOARD_STREAM_KEY_B64=<set-by-secret>
BCRYPT_COST=12
AUTH_FAILURE_MIN_MS=500
AUTH_FAILURE_JITTER_MS=20
PAIRING_FAILURE_MIN_MS=100
PAIRING_FAILURE_JITTER_MS=20
BOARD_ALLOWED_ORIGINS=http://127.0.0.1:3410
BOARD_PUBLIC_API_ORIGIN=http://127.0.0.1:3411
TRUSTED_PROXY_CIDRS=
REVISION_RETENTION_COUNT=32
ACCOUNT_API_KEY_ISSUANCE_ENABLED=false
ACCOUNT_API_KEY_AUTH_ENABLED=false
BOARD_DOCUMENT_V3_WRITE_ENABLED=false
SCENEBOARD_EXPORT_API_ORIGIN=http://127.0.0.1:3411
SCENEBOARD_EXPORT_WEB_ORIGIN=http://127.0.0.1:3410
SCENEBOARD_EXPORT_ARTIFACT_RUNTIME_ORIGIN=http://127.0.0.2:3412
SCENEBOARD_EXPORT_CHROMIUM_EXECUTABLE=/opt/sceneboard/ms-playwright/chromium-1217/chrome-linux64/chrome
# 개발 호스트가 Chromium sandbox를 제공하지 못할 때만 사용합니다. production에서는 무시됩니다.
SCENEBOARD_EXPORT_DISABLE_CHROMIUM_SANDBOX=false
