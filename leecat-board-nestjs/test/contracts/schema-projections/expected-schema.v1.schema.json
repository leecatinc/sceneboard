{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneboard.dev/schemas/certification/expected-schema.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "contractSha256",
    "registryEntries",
    "tables"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "enum": [
        "D2",
        "D3",
        "D7",
        "D8"
      ]
    },
    "contractSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registryEntries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "version",
          "upAsset",
          "upSha256",
          "downAsset",
          "downSha256",
          "reversible",
          "predecessorIds"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "upAsset": {
            "type": "string",
            "pattern": "^[0-9]{3}_[a-z0-9_]+\\.up\\.sql$"
          },
          "upSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "downAsset": {
            "type": [
              "string",
              "null"
            ]
          },
          "downSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "reversible": {
            "type": "boolean"
          },
          "predecessorIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sourceAsset",
          "sourceSha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "sourceAsset": {
            "type": "string",
            "pattern": "^[0-9]{3}_[a-z0-9_]+\\.up\\.sql$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
