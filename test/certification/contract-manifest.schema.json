{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneboard.dev/schemas/contract-manifest.v1.schema.json",
  "title": "SceneBoard declarative contract manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceSchemaVersion",
    "inventorySha256",
    "manifestSchemaSha256",
    "nodeNpmPolicy",
    "dependencyPolicy",
    "topology",
    "migrations",
    "toolRegistry",
    "corpus",
    "ownerPublishers",
    "schemaModel",
    "installedSkill",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceSchemaVersion": { "const": 1 },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "manifestSchemaSha256": { "$ref": "#/$defs/sha256" },
    "nodeNpmPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm"],
      "properties": {
        "node": { "const": ">=22" },
        "npm": { "const": "10.9.3" }
      }
    },
    "dependencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryHost", "lockfileSha256", "inventorySha256", "dependencyCount"],
      "properties": {
        "registryHost": { "const": "registry.npmjs.org" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "inventorySha256": { "$ref": "#/$defs/sha256" },
        "dependencyCount": { "type": "integer", "minimum": 1 }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appOrigin", "apiOrigin", "artifactRuntimeOrigin", "mcpTransport", "mysqlDatabase", "redisKeyPrefix", "listeners", "writers"],
      "properties": {
        "appOrigin": { "const": "http://127.0.0.1:3410" },
        "apiOrigin": { "const": "http://127.0.0.1:3411" },
        "artifactRuntimeOrigin": { "const": "http://127.0.0.2:3412" },
        "mcpTransport": { "const": "stdio" },
        "mysqlDatabase": { "const": "sceneboard" },
        "redisKeyPrefix": { "const": "sceneboard:" },
        "listeners": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/ownership" } },
        "writers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/ownership" } }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryCount", "sqlAssetCount", "versions", "registrySha256", "assetSetSha256"],
      "properties": {
        "entryCount": { "const": 18 },
        "sqlAssetCount": { "const": 21 },
        "versions": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "type": "string" }, "uniqueItems": true },
        "registrySha256": { "$ref": "#/$defs/sha256" },
        "assetSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preAuthCount", "coreCount", "finalCount", "terminalNames"],
      "properties": {
        "preAuthCount": { "const": 3 },
        "coreCount": { "const": 15 },
        "finalCount": { "const": 21 },
        "terminalNames": { "type": "array", "minItems": 21, "maxItems": 21, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureCount", "catalogSha256", "aggregateSha256"],
      "properties": {
        "fixtureCount": { "const": 181 },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ownerPublishers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "publisherPath", "publisherSha256", "tupleListSha256", "contractIds", "selectorCount"],
        "properties": {
          "owner": { "enum": ["D2", "D3", "D5", "D7", "D8"] },
          "publisherPath": { "type": "string" },
          "publisherSha256": { "$ref": "#/$defs/sha256" },
          "tupleListSha256": { "$ref": "#/$defs/sha256" },
          "contractIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "selectorCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "schemaModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractSha256", "aggregateTestSha256", "ownerProjections", "aggregateSha256"],
      "properties": {
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "aggregateTestSha256": { "$ref": "#/$defs/sha256" },
        "ownerProjections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "sha256"],
            "properties": {
              "owner": { "enum": ["D2", "D3", "D7", "D8"] },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "installedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "aggregateSha256"],
      "properties": {
        "fileCount": { "const": 30 },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 399,
      "maxItems": 399,
      "items": { "$ref": "#/$defs/resourceResult" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner"],
      "properties": {
        "owner": { "pattern": "^D[1-9]$" },
        "origin": { "type": "string" },
        "resource": { "type": "string" }
      },
      "oneOf": [
        { "required": ["origin"], "not": { "required": ["resource"] } },
        { "required": ["resource"], "not": { "required": ["origin"] } }
      ]
    },
    "resourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "owner", "canonicalPath", "exportName", "exportKind", "selectorSha256", "canonicalization", "fingerprintSha256"],
      "properties": {
        "key": { "type": "string" },
        "owner": { "pattern": "^D[1-9]$" },
        "canonicalPath": { "type": "string", "minLength": 1 },
        "exportName": { "type": ["string", "null"] },
        "exportKind": { "enum": ["type", "interface", "class", null] },
        "selectorSha256": { "$ref": "#/$defs/sha256" },
        "canonicalization": { "enum": ["utf8-lf", "canonical-json", "typescript-ast"] },
        "fingerprintSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
