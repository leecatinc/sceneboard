{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneboard.dev/schemas/release-index.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptEnvelope", "status", "phases", "cleanupStatus", "evidenceTreeSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "attemptEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificationSourceCommit", "manifestSha256", "observedInputHashes", "profile", "attemptId", "laneId"],
      "properties": {
        "certificationSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "observedInputHashes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" },
          "minProperties": 1
        },
        "profile": { "type": "string" },
        "attemptId": { "type": "string" },
        "laneId": { "enum": ["correctness", "capacity"] }
      },
      "not": { "required": ["inventorySha256"] }
    },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "phases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "cleanupStatus": { "enum": ["PASS", "FAIL", "NOT_STARTED"] },
    "evidenceTreeSha256": { "$ref": "#/$defs/sha256" },
    "presentationManifestSha256": { "$ref": "#/$defs/sha256" },
    "runExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "status", "path", "recordSha256", "attemptId"],
      "properties": {
        "decisionId": { "const": "AMD-06" },
        "status": { "const": "excluded-by-user-current-run" },
        "path": { "const": "exclusions/AMD-06.json" },
        "recordSha256": { "$ref": "#/$defs/sha256" },
        "attemptId": { "type": "string" }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
