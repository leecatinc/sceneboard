{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneboard.dev/schemas/evidence-record.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rowId", "phase", "owner", "status", "safeCode", "inputSha256", "resultSha256", "cleanupStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rowId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
    "phase": { "type": "string" },
    "owner": { "pattern": "^D[1-9]$" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"] },
    "safeCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "inputSha256": { "$ref": "#/$defs/sha256" },
    "resultSha256": { "$ref": "#/$defs/sha256" },
    "cleanupStatus": { "enum": ["PASS", "FAIL", "NOT_STARTED"] }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
